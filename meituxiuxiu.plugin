#!name=美图秀秀接口开发测试
#!desc=将原响应脚本规则转换为 Loon 插件格式，仅用于已获授权的开发测试。
#!author=Moli-X

[Script]
http-response ^https?:\/\/(h5|api)\.xiuxiu\.meitu\.com\/v\d\/(h\d\/vip|vip|user)\/ script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/MTxiuxiu/MeiTu.js, requires-body=true, timeout=60, tag=美图接口开发测试-VIP, enable=true
http-response ^https:\/\/api\.xiuxiu\.meitu\.com\/v1 script-path=https://raw.githubusercontent.com/Moli-X/Resources/main/Script/MTxiuxiu/MTxiuxiu.js, requires-body=true, timeout=60, tag=美图接口开发测试-v1, enable=true

[MITM]
hostname = *.xiuxiu.meitu.com, api.xiuxiu.meitu.com
